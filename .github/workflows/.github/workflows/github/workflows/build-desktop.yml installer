name: Build desktop installer
on:
  push:
    branches:
      - main
  workflow_dispatch:
jobs:
  build:
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: windows-latest
            target: win
            artifact_glob: release/*.exe
            artifact_name: qora-epos-windows
          - os: ubuntu-latest
            target: linux
            artifact_glob: release/*.AppImage
            artifact_name: qora-epos-linux
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: npm
      - run: npm ci
      - run: npm run build
      - name: Package
        shell: bash
        run: npx electron-builder --${{ matrix.target }} --projectDir electron
      - uses: actions/upload-artifact@v4
        with:
          name: ${{ matrix.artifact_name }}
          path: ${{ matrix.artifact_glob }}
          if-no-files-found: error
