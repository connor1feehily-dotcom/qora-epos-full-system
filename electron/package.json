{
  "name": "qora-epos-desktop",
  "version": "1.0.0",
  "description": "Qora EPOS — desktop till app for Kerrigans XL Manorhamilton",
  "main": "main.js",
  "author": "Kerrigans XL",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron ."
  },
  "build": {
    "appId": "ie.kerrigansxl.qoraepos",
    "productName": "Qora EPOS",
    "electronVersion": "37.4.0",
    "asar": false,
    "directories": {
      "buildResources": "assets",
      "output": "../release"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "app/dist",
        "filter": ["**/*"]
      },
      {
        "from": "../node_modules",
        "to": "app/node_modules",
        "filter": ["**/*", "!**/{test,tests,docs,examples,.bin}/**"]
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Qora EPOS",
      "artifactName": "Qora-EPOS-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [{ "target": "AppImage", "arch": ["x64"] }],
      "icon": "assets/icon.png",
      "category": "Office",
      "artifactName": "Qora-EPOS-${version}.${ext}"
    }
  }
}
